<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#DDE5E1" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#B4C2BC" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B9E6D6" />
            <corners android:radius="18dp" />
            <stroke android:width="4dp" android:color="#0B7A59" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D6F0E6" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#0B7A59" />
        </shape>
    </item>
</selector>
